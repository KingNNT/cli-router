#!/usr/bin/env bash
#MISE description="Stop and remove the proxy service (LaunchAgent on macOS, systemd --user on Linux)"
#MISE alias="su"

set -euo pipefail

ROOT_TASKS="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=_lib.sh
. "$ROOT_TASKS/_lib.sh"

uninstall_macos() {
    if [ -f "$SERVICE_UNIT_PATH" ]; then
        launchctl bootout "$SERVICE_TARGET" 2>/dev/null || true

        # bootout can return before launchd has reaped the process; wait
        # so a follow-up bootstrap (prod:deploy) doesn't hit AddrInUse
        # on the same port.
        for _ in $(seq 1 50); do
            launchctl print "$SERVICE_TARGET" >/dev/null 2>&1 || break
            sleep 0.1
        done
        if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
            echo "warning: $SERVICE_TARGET still loaded after 5s" >&2
        fi

        rm -f "$SERVICE_UNIT_PATH"
        echo "service uninstalled"
    else
        echo "service not installed"
    fi
}

uninstall_linux() {
    if [ -f "$SERVICE_UNIT_PATH" ]; then
        # Disable + stop atomically. Ignore errors if already stopped.
        systemctl --user disable --now "$SERVICE_LABEL" 2>/dev/null || true

        # systemd --user may need a beat to reap the process before
        # `prod:deploy` reinstalls on the same port (AddrInUse race).
        for _ in $(seq 1 50); do
            systemctl --user is-active "$SERVICE_LABEL" >/dev/null 2>&1 || break
            sleep 0.1
        done
        if systemctl --user is-active "$SERVICE_LABEL" >/dev/null 2>&1; then
            echo "warning: $SERVICE_LABEL still active after 5s" >&2
        fi

        rm -f "$SERVICE_UNIT_PATH"
        echo "service uninstalled"
    else
        echo "service not installed"
    fi
}

case "$OS" in
    macos) uninstall_macos ;;
    linux) uninstall_linux ;;
esac
