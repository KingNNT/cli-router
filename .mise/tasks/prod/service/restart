#!/usr/bin/env bash
#MISE description="Restart the proxy service (atomic kickstart on macOS, systemctl restart on Linux)"
#MISE alias="sr"

set -euo pipefail

ROOT_TASKS="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=_lib.sh
. "$ROOT_TASKS/_lib.sh"

restart_macos() {
    if [ ! -f "$SERVICE_UNIT_PATH" ]; then
        echo "error: service not installed. Run 'mise run prod:service:install' first." >&2
        exit 1
    fi

    if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
        launchctl kickstart -k "$SERVICE_TARGET"
    else
        launchctl bootstrap "gui/$(id -u)" "$SERVICE_UNIT_PATH"
    fi

    : > "$SERVICE_LOG_ERR"
    echo "service restarted"
}

restart_linux() {
    if [ ! -f "$SERVICE_UNIT_PATH" ]; then
        echo "error: service not installed. Run 'mise run prod:service:install' first." >&2
        exit 1
    fi

    if systemctl --user is-enabled "$SERVICE_LABEL" >/dev/null 2>&1; then
        systemctl --user restart "$SERVICE_LABEL"
    else
        # First-time enable + start.
        systemctl --user enable --now "$SERVICE_LABEL"
    fi

    echo "service restarted"
}

case "$OS" in
    macos) restart_macos ;;
    linux) restart_linux ;;
esac
