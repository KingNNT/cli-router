# Local environment overrides for cli-router development.
#
# `make dev` and `make dev-tui` auto-source this file (./.env) if it exists.
# The launchd-managed prod proxy is unaffected — it inherits launchd's env,
# not your shell.
#
# Copy this file to `.env` (gitignored) and uncomment what you need.

# ─── Proxy resolution ──────────────────────────────────────────────────
# Profile selects which config file the proxy reads:
#   dev  → ~/.config/cli-router/config.dev.toml
#   prod → ~/.config/cli-router/config.toml  (default)
# CLI_ROUTER_PROFILE=dev

# Explicit config-file path. Wins over CLI_ROUTER_PROFILE.
# CLI_ROUTER_CONFIG=/absolute/path/to/config.toml

# Where proxy-tui talks to the daemon. Defaults: prod 8787, dev 8788.
# CLI_ROUTER_PROXY_URL=http://127.0.0.1:8788

# ─── Tracing ──────────────────────────────────────────────────────────
# Standard env-filter syntax. Default: "info,proxy=debug".
# RUST_LOG=info,proxy=trace

# ─── Secrets (interpolated into config.toml via ${VAR}) ───────────────
# Reference these from config.toml like:
#   [[providers]]
#   auth = { type = "bearer", value = "${ZAI_API_KEY}" }
# Keeping secrets here (gitignored) instead of inline in config.toml means
# they don't end up in version control or in copies like config.dev.toml.
# ZAI_API_KEY=
